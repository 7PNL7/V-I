<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #f0f4f8;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* Header */
    .header {
      background:linear-gradient(135deg,#1F3864 0%,#2E75B6 100%);
      padding:16px 40px; display:flex; justify-content:space-between; align-items:center;
      box-shadow:0 4px 20px rgba(31,56,100,0.3);
    }
    .header h1 { color:#fff; font-size:20px; font-weight:700; }
    .header h1 span { font-weight:400; opacity:0.8; }
    .header nav a {
      color:#fff; text-decoration:none; margin-left:16px; font-size:13px;
      font-weight:500; padding:7px 14px; border-radius:6px; transition:background .2s;
    }
    .header nav a:hover { background:rgba(255,255,255,0.15); }
    .header nav a.active { background:rgba(255,255,255,0.2); }
      transition: background 0.2s;
    }
    .header nav a:hover { background: rgba(255,255,255,0.15); }
    .header nav a.active { background: rgba(255,255,255,0.2); }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 30px 20px;
      flex: 1;
    }

    /* Page title */
    .page-title {
      font-size: 28px;
      font-weight: 700;
      color: #1F3864;
      margin-bottom: 8px;
    }
    .page-subtitle {
      color: #666;
      font-size: 15px;
      margin-bottom: 30px;
    }

    /* Two columns */
    .order-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    @media (max-width: 768px) { .order-layout { grid-template-columns: 1fr; } }

    /* Card */
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 28px 30px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .card h2 {
      font-size: 18px;
      font-weight: 600;
      color: #1F3864;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 2px solid #e8edf5;
    }

    /* Form */
    .form-group { margin-bottom: 18px; }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #444;
      margin-bottom: 5px;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 2px solid #e0e6ed;
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.2s;
      background: #fafbfc;
    }
    .form-group input:focus, .form-group select:focus {
      outline: none;
      border-color: #2E75B6;
      background: #fff;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .btn {
      padding: 12px 28px;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .btn-primary {
      background: linear-gradient(135deg, #1F3864, #2E75B6);
      color: #fff;
      width: 100%;
      margin-top: 5px;
    }
    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 15px rgba(31,56,100,0.4);
    }
    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    /* Product selector */
    .product-option {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .product-option small { color: #888; font-weight: 400; }

    /* Success message */
    .alert {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 500;
    }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .hidden { display: none; }

    /* Recent orders table */
    .orders-table {
      width: 100%;
      border-collapse: collapse;
    }
    .orders-table th {
      text-align: left;
      padding: 10px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid #e8edf5;
    }
    .orders-table td {
      padding: 12px;
      font-size: 14px;
      color: #333;
      border-bottom: 1px solid #f0f2f5;
    }
    .orders-table tr:hover td { background: #f8faff; }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-pending { background: #fff3cd; color: #856404; }
    .badge-approved { background: #d4edda; color: #155724; }
    .badge-production { background: #cce5ff; color: #004085; }
    .badge-completed { background: #d1ecf1; color: #0c5460; }
    .badge-cancelled { background: #f8d7da; color: #721c24; }

    .empty-state {
      text-align: center;
      padding: 40px;
      color: #999;
    }
    .empty-state h3 { font-size: 18px; margin-bottom: 8px; color: #666; }

    .loading {
      text-align: center;
      padding: 30px;
      color: #888;
    }
    .loading::after {
      content: '...';
      animation: dots 1.5s infinite;
    }
    @keyframes dots { 0%,20% { content: '.'; } 40% { content: '..'; } 60%,100% { content: '...'; } }

    /* Footer */
    .footer {
      text-align: center;
      padding: 20px;
      color: #999;
      font-size: 13px;
      border-top: 1px solid #e0e6ed;
      margin-top: 20px;
    }
  </style>
</head>
<body>

<!-- Header -->
<div class="header">
  <h1>🏭 <span>Fabric Production</span></h1>
  <nav>
    <a href="/">🏠 Trang chủ</a>
    <a href="/place-order" class="active">📝 Đặt hàng</a>
    <a href="/admin/orders">📋 Đơn hàng</a>
    <a href="/admin/production">⚙️ Điều phối</a>
    <a href="/admin/materials">🧵 Kho</a>
    <a href="/admin/products">📦 SP</a>
  </nav>
</div>

<div class="container">

  <h1 class="page-title">📝 Đặt hàng sản xuất</h1>
  <p class="page-subtitle">Điền thông tin bên dưới để gửi đơn hàng gia công may mặc</p>

  <!-- Alert messages -->
  <div id="alert-success" class="alert alert-success hidden">
    ✅ Đặt hàng thành công! Mã đơn: <strong id="order-id-display"></strong>
  </div>
  <div id="alert-error" class="alert alert-error hidden">
    ❌ <span id="error-message"></span>
  </div>

  <div class="order-layout">

    <!-- LEFT: Form -->
    <div class="card">
      <h2>📄 Thông tin đơn hàng</h2>
      <form id="orderForm" onsubmit="return submitOrder(event)">

        <div class="form-row">
          <div class="form-group">
            <label for="ten_kh">Tên khách hàng *</label>
            <input type="text" id="ten_kh" name="ten_kh" required placeholder="VD: Công ty ZARA">
          </div>
          <div class="form-group">
            <label for="sdt">Số điện thoại *</label>
            <input type="tel" id="sdt" name="sdt" required placeholder="0912345678">
          </div>
        </div>

        <div class="form-group">
          <label for="ma_sp">Chọn sản phẩm *</label>
          <select id="ma_sp" name="ma_sp" required onchange="updateProductInfo()">
            <option value="">-- Chọn sản phẩm --</option>
            <% products.forEach(p => { %>
            <option value="<%= p.ma_sp %>" data-price="<%= p.price || 0 %>" data-stock="<%= p.stock || 0 %>">
              [<%= p.ma_sp %>] <%= p.ten_sp %>
            </option>
            <% }) %>
          </select>
        </div>

        <div id="product-info" class="hidden" style="background:#eef4ff;padding:10px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;color:#1F3864;">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="so_luong">Số lượng *</label>
            <input type="number" id="so_luong" name="so_luong" min="1" required placeholder="VD: 1000">
          </div>
          <div class="form-group">
            <label for="ngay_giao">Ngày giao hàng *</label>
            <input type="date" id="ngay_giao" name="ngay_giao" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="submitBtn">
          🚀 Gửi đơn hàng
        </button>
      </form>
    </div>

    <!-- RIGHT: Recent orders -->
    <div class="card">
      <h2>📋 Đơn hàng gần đây</h2>
      <div id="recent-orders">
        <div class="loading" id="loading-orders">Đang tải</div>
      </div>
    </div>

  </div>
</div>

<div class="footer">
  © 2026 Fabric Production Management System
</div>

<script>
  // Gán ngày mặc định cho ngày giao (30 ngày sau)
  document.addEventListener('DOMContentLoaded', function() {
    const dateInput = document.getElementById('ngay_giao');
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.value = tomorrow.toISOString().split('T')[0];
    dateInput.min = dateInput.value;

    loadRecentOrders();
  });

  // Hiển thị thông tin sản phẩm khi chọn
  function updateProductInfo() {
    const sel = document.getElementById('ma_sp');
    const opt = sel.options[sel.selectedIndex];
    const info = document.getElementById('product-info');
    if (opt && opt.value) {
      info.innerHTML = `<strong>${opt.text}</strong> | Giá: ${Number(opt.dataset.price).toLocaleString()}đ | Tồn kho: ${opt.dataset.stock}`;
      info.classList.remove('hidden');
    } else {
      info.classList.add('hidden');
    }
  }

  // Gửi đơn hàng
  async function submitOrder(e) {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Đang xử lý...';

    const data = {
      ten_kh: document.getElementById('ten_kh').value.trim(),
      sdt: document.getElementById('sdt').value.trim(),
      ma_sp: document.getElementById('ma_sp').value,
      so_luong: parseInt(document.getElementById('so_luong').value),
      ngay_giao: document.getElementById('ngay_giao').value,
      ngay_nhan: new Date().toISOString().split('T')[0]
    };

    // Tự sinh mã đơn
    data.ma_dh = 'DH-' + new Date().getFullYear() + '-' + 
      String(Date.now()).slice(-4) + String(Math.floor(Math.random()*100)).padStart(2,'0');

    try {
      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();

      if (res.ok) {
        document.getElementById('order-id-display').textContent = data.ma_dh;
        document.getElementById('alert-success').classList.remove('hidden');
        document.getElementById('alert-error').classList.add('hidden');
        document.getElementById('orderForm').reset();
        loadRecentOrders();
        // Tự động ẩn thông báo sau 5s
        setTimeout(() => document.getElementById('alert-success').classList.add('hidden'), 5000);
      } else {
        showError(result.msg || 'Lỗi không xác định');
      }
    } catch (err) {
      showError('Không thể kết nối đến server');
    }

    btn.disabled = false;
    btn.textContent = '🚀 Gửi đơn hàng';
  }

  function showError(msg) {
    document.getElementById('error-message').textContent = msg;
    document.getElementById('alert-error').classList.remove('hidden');
    document.getElementById('alert-success').classList.add('hidden');
    setTimeout(() => document.getElementById('alert-error').classList.add('hidden'), 5000);
  }

  // Tải danh sách đơn hàng gần đây
  async function loadRecentOrders() {
    const container = document.getElementById('recent-orders');
    try {
      const res = await fetch('/api/orders/recent');
      const orders = await res.json();
      
      if (!orders.length) {
        container.innerHTML = `<div class="empty-state"><h3>📭 Chưa có đơn hàng</h3><p>Hãy đặt đơn hàng đầu tiên của bạn!</p></div>`;
        return;
      }

      let html = `<table class="orders-table">
        <tr><th>Mã ĐH</th><th>Khách hàng</th><th>Sản phẩm</th><th>SL</th><th>Giao</th><th>Trạng thái</th></tr>`;
      orders.forEach(o => {
        const statusClass = 'badge-' + (o.status || 'pending');
        html += `<tr>
          <td><strong>${o.ma_dh}</strong></td>
          <td>${o.ten_kh}</td>
          <td>${o.product ? o.product.ten_sp : o.ma_sp}</td>
          <td>${Number(o.so_luong).toLocaleString()}</td>
          <td>${o.ngay_giao || '—'}</td>
          <td><span class="badge ${statusClass}">${o.status || 'pending'}</span></td>
        </tr>`;
      });
      html += `</table>`;
      container.innerHTML = html;
    } catch (err) {
      container.innerHTML = `<div class="empty-state"><h3>⚠️ Lỗi tải dữ liệu</h3></div>`;
    }
  }
</script>

</body>
</html>
