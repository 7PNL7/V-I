<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',Arial,sans-serif; background:#f0f4f8; min-height:100vh; }
    .header { background:linear-gradient(135deg,#1F3864 0%,#2E75B6 100%); padding:16px 40px; display:flex; justify-content:space-between; align-items:center; box-shadow:0 4px 20px rgba(31,56,100,0.3); }
    .header h1 { color:#fff; font-size:20px; font-weight:700; }
    .header h1 span { font-weight:400; opacity:0.8; }
    .header nav a { color:#fff; text-decoration:none; margin-left:16px; font-size:13px; font-weight:500; padding:7px 14px; border-radius:6px; transition:background .2s; }
    .header nav a:hover { background:rgba(255,255,255,0.15); }
    .header nav a.active { background:rgba(255,255,255,0.2); }
    .container { max-width:1600px; margin:0 auto; padding:20px; }
    .page-header { margin-bottom:20px; }
    .page-header h1 { font-size:24px; font-weight:700; color:#1F3864; }
    .page-header p { font-size:14px; color:#666; margin-top:4px; }
    .stats-row { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:20px; }
    @media(max-width:900px){.stats-row{grid-template-columns:repeat(2,1fr);}}
    .stat-card { background:#fff; border-radius:10px; padding:16px 18px; box-shadow:0 2px 8px rgba(0,0,0,0.05); border-left:4px solid #2E75B6; }
    .stat-card .num { font-size:24px; font-weight:800; color:#1F3864; }
    .stat-card .lbl { font-size:12px; color:#888; margin-top:2px; }
    .layout { display:grid; grid-template-columns:1fr 360px; gap:20px; }
    @media(max-width:1200px){.layout{grid-template-columns:1fr;}}
    .gantt-card { background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06); overflow:hidden; }
    .gantt-card h2 { font-size:16px; font-weight:600; color:#1F3864; padding:16px 20px; border-bottom:2px solid #e8edf5; }
    .gantt-scroll { overflow-x:auto; padding:0 0 12px; }
    .gantt-table { min-width:900px; }
    .gantt-header-row { display:flex; border-bottom:2px solid #e8edf5; position:sticky; top:0; z-index:10; background:#f8faff; }
    .gantt-header-label { min-width:180px; padding:10px 14px; font-size:11px; font-weight:600; color:#888; text-transform:uppercase; border-right:1px solid #e8edf5; flex-shrink:0; }
    .gantt-header-date { flex:1; display:flex; }
    .gantt-header-date .col { min-width:38px; padding:6px 2px; text-align:center; border-right:1px solid #f0f2f5; font-size:10px; color:#999; }
    .gantt-header-date .col .num { font-size:12px; font-weight:700; color:#1F3864; display:block; }
    .gantt-header-date .col.weekend { background:#f8f8fc; }
    .gantt-header-date .col.today { background:#e8f4ff; border-bottom:2px solid #2E75B6; }
    .gantt-row { display:flex; border-bottom:1px solid #f0f2f5; min-height:56px; transition:background .2s; }
    .gantt-row:hover { background:#f8fbff; }
    .gantt-row-label { min-width:180px; padding:10px 14px; border-right:1px solid #e8edf5; flex-shrink:0; display:flex; align-items:center; gap:8px; }
    .gantt-row-label .dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
    .gantt-row-label .dot.idle { background:#6c757d; }
    .gantt-row-label .dot.running { background:#28a745; }
    .gantt-row-label .dot.stopped { background:#dc3545; }
    .gantt-row-label .name { font-size:13px; font-weight:600; color:#1F3864; }
    .gantt-row-label .code { font-size:11px; color:#999; }
    .gantt-timeline { flex:1; display:flex; position:relative; min-height:56px; }
    .gantt-timeline .col { min-width:38px; border-right:1px solid #f0f2f5; position:relative; }
    .gantt-timeline .col.weekend { background:#fafafc; }
    .gantt-timeline .col.today { background:#e8f4ff; }
    .gantt-job { position:absolute; top:6px; height:44px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:600; color:#fff; cursor:pointer; transition:all .2s; z-index:5; overflow:hidden; padding:0 4px; min-width:4px; box-shadow:0 1px 4px rgba(0,0,0,0.15); }
    .gantt-job:hover { transform:scaleY(1.05); box-shadow:0 3px 10px rgba(0,0,0,0.25); z-index:20; }
    .gantt-job.running { background:linear-gradient(135deg,#90EE90,#28a745); border:1px solid #28a745; }
    .gantt-job.queued { background:linear-gradient(135deg,#74b9ff,#0984e3); border:1px solid #0984e3; }
    .gantt-job.overdue { background:linear-gradient(135deg,#ff7675,#d63031); border:1px solid #d63031; animation:pulseOverdue 1.5s infinite; }
    .gantt-job.completed { background:linear-gradient(135deg,#b2bec3,#636e72); border:1px solid #636e72; }
    @keyframes pulseOverdue { 0%,100%{opacity:1} 50%{opacity:0.85} }
    .gantt-job.free-slot { background:rgba(46,117,182,0.08); border:2px dashed rgba(46,117,182,0.3); color:#2E75B6; cursor:pointer; z-index:3; box-shadow:none; }
    .gantt-job.free-slot:hover { background:rgba(46,117,182,0.2); border-color:#2E75B6; box-shadow:0 0 0 3px rgba(46,117,182,0.1); }
    .gantt-job .label { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sidebar-card { background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06); margin-bottom:16px; }
    .sidebar-card h3 { font-size:14px; font-weight:600; color:#1F3864; padding:14px 16px; border-bottom:2px solid #e8edf5; }
    .sidebar-body { padding:12px 16px; max-height:400px; overflow-y:auto; }
    .order-item { padding:10px 12px; border:2px solid #e8edf5; border-radius:8px; margin-bottom:8px; cursor:pointer; transition:all .2s; }
    .order-item:hover { border-color:#2E75B6; background:#f0f7ff; }
    .order-item.selected { border-color:#1F3864; background:#e8f0fe; }
    .order-item .oi-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
    .order-item .oi-code { font-weight:700; font-size:13px; color:#1F3864; }
    .order-item .oi-customer { font-size:12px; color:#666; }
    .order-item .oi-details { display:flex; justify-content:space-between; font-size:11px; color:#888; margin-top:4px; }
    .btn { padding:8px 18px; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; transition:all .2s; }
    .btn-primary { background:linear-gradient(135deg,#1F3864,#2E75B6); color:#fff; }
    .btn-primary:hover { transform:translateY(-1px); box-shadow:0 4px 12px rgba(31,56,100,0.3); }
    .btn-primary:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
    .btn-outline { background:transparent; border:2px solid #1F3864; color:#1F3864; }
    .btn-outline:hover { background:#1F3864; color:#fff; }
    .btn-success { background:#28a745; color:#fff; }
    .btn-success:hover { background:#218838; }
    .btn-sm { padding:5px 12px; font-size:11px; }
    .assign-bar { padding:14px 18px; background:#e8f4ff; border-radius:8px; margin:8px 12px 12px; display:none; flex-wrap:wrap; gap:10px; align-items:center; }
    .assign-bar.visible { display:flex; }
    .badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; }
    .badge-pending { background:#fff3cd; color:#856404; }
    .badge-approved { background:#d4edda; color:#155724; }
    .badge-production { background:#cce5ff; color:#004085; }
    .badge-completed { background:#d1ecf1; color:#0c5460; }
    .toast { position:fixed; top:20px; right:20px; padding:14px 22px; border-radius:8px; font-size:14px; font-weight:500; z-index:3000; display:none; box-shadow:0 4px 15px rgba(0,0,0,0.15); animation:slideIn .3s; }
    .toast-success { background:#d4edda; color:#155724; border:1px solid #c3e6cb; display:block; }
    .toast-error { background:#f8d7da; color:#721c24; border:1px solid #f5c6cb; display:block; }
    @keyframes slideIn { from{transform:translateX(100px);opacity:0;} to{transform:translateX(0);opacity:1;} }
    .footer { text-align:center; padding:20px; color:#999; font-size:13px; margin-top:20px; }
    .empty-state { text-align:center; padding:40px; color:#999; }
    .empty-state h3 { font-size:16px; color:#666; }
    /* Date control bar */
    .date-controls { display:flex; align-items:center; gap:10px; padding:14px 20px; background:#f8faff; border-bottom:1px solid #e8edf5; flex-wrap:wrap; }
    .date-controls label { font-size:12px; font-weight:600; color:#555; }
    .date-controls input[type="date"] { padding:6px 10px; border:2px solid #e0e6ed; border-radius:6px; font-size:13px; font-family:inherit; color:#333; }
    .date-controls input[type="date"]:focus { outline:none; border-color:#2E75B6; }
    .date-controls .range-label { font-size:13px; font-weight:600; color:#1F3864; min-width:90px; }
    .date-nav-group { display:flex; gap:4px; }
    .date-nav-group .btn-nav { padding:5px 12px; border:1px solid #e0e6ed; border-radius:6px; background:#fff; font-size:12px; cursor:pointer; transition:all .15s; font-family:inherit; color:#555; }
    .date-nav-group .btn-nav:hover { background:#e8f4ff; border-color:#2E75B6; color:#2E75B6; }
    .date-nav-group .btn-nav.active { background:#1F3864; color:#fff; border-color:#1F3864; }
  </style>
</head>
<body>

<div class="header">
  <h1>🏭 <span>Fabric Production</span></h1>
  <nav>
    <a href="/">🏠 Trang chủ</a>
    <a href="/place-order">📝 Đặt hàng</a>
    <a href="/admin/orders">📋 Đơn hàng</a>
    <a href="/admin/production">⚙️ Điều phối</a>
    <a href="/admin/schedule-planning" class="active">📅 Lịch SX</a>
    <a href="/admin/materials">🧵 Kho</a>
    <a href="/admin/products">📦 SP</a>
  </nav>
</div>

<div class="container">
  <div class="page-header">
    <h1>📅 Lịch sản xuất tổng thể</h1>
    <p>Tổng quan tất cả dây chuyền sản xuất — 30 ngày tới</p>
  </div>

  <div class="stats-row">
    <div class="stat-card" style="border-left-color:#2E75B6;"><div class="num" id="statLines">—</div><div class="lbl">🏗️ Dây chuyền</div></div>
    <div class="stat-card" style="border-left-color:#28a745;"><div class="num" id="statRunning">—</div><div class="lbl">▶️ Đang hoạt động</div></div>
    <div class="stat-card" style="border-left-color:#ffc107;"><div class="num" id="statPending">—</div><div class="lbl">⏳ Đơn chờ xử lý</div></div>
    <div class="stat-card" style="border-left-color:#6f42c1;"><div class="num" id="statUtil">—%</div><div class="lbl">📊 Tỉ lệ sử dụng</div></div>
    <div class="stat-card" style="border-left-color:#dc3545; display:none;" id="overdueStat"><div class="num" id="statOverdue">0</div><div class="lbl">🔴 Đơn trễ hạn</div></div>
  </div>

  <div class="layout">
    <!-- Left: Gantt -->
    <div class="gantt-card">
      <h2>🏗️ Biểu đồ Gantt — Tất cả dây chuyền</h2>
      <div class="date-controls">
        <label>📅 Từ:</label>
        <input type="date" id="startDate">
        <label>Đến:</label>
        <input type="date" id="endDate">
        <button class="btn btn-primary btn-sm" onclick="applyDateRange()">Xem</button>
        <span style="color:#d0d5dd;">|</span>
        <div class="date-nav-group">
          <button class="btn-nav" onclick="quickRange(7,this)">7 ngày</button>
          <button class="btn-nav active" onclick="quickRange(30,this)">30 ngày</button>
          <button class="btn-nav" onclick="quickRange(60,this)">60 ngày</button>
        </div>
        <span style="color:#d0d5dd;">|</span>
        <div class="date-nav-group">
          <button class="btn-nav" onclick="shiftDays(-30)">◀ 30 ngày</button>
          <button class="btn-nav" onclick="shiftDays(-7)">◀ 7 ngày</button>
          <button class="btn-nav" onclick="goToToday()">📌 Hôm nay</button>
          <button class="btn-nav" onclick="shiftDays(7)">7 ngày ▶</button>
          <button class="btn-nav" onclick="shiftDays(30)">30 ngày ▶</button>
        </div>
        <div style="margin-left:auto;font-size:12px;color:#888;">
          <span id="rangeLabel" class="range-label">—</span>
        </div>
      </div>
      <div class="gantt-scroll">
        <div class="gantt-table">
          <div class="gantt-header-row">
            <div class="gantt-header-label">Dây chuyền</div>
            <div class="gantt-header-date" id="ganttDates"></div>
          </div>
          <div class="gantt-body" id="ganttBody">
            <div style="padding:40px;text-align:center;color:#999;">Đang tải dữ liệu...</div>
          </div>
        </div>
      </div>
      <div class="assign-bar" id="assignBar">
        <span style="font-size:13px;font-weight:600;color:#1F3864;">📌 Đơn: <span id="assignOrderLabel">—</span></span>
        <span style="font-size:13px;color:#666;">→</span>
        <span style="font-size:13px;font-weight:600;color:#1F3864;">Dây chuyền: <span id="assignLineLabel">—</span></span>
        <span style="font-size:13px;color:#666;">📅</span>
        <span style="font-size:13px;" id="assignDateLabel">—</span>
        <button class="btn btn-success btn-sm" id="confirmAssignBtn" onclick="confirmAssign()">✅ Gán đơn</button>
        <button class="btn btn-outline btn-sm" onclick="cancelAssign()">✕ Hủy</button>
      </div>
    </div>

    <!-- Right: Order List -->
    <div>
      <div class="sidebar-card">
        <h3>📋 Đơn hàng chờ</h3>
        <div class="sidebar-body" id="orderList"><div class="empty-state"><h3>Đang tải...</h3></div></div>
      </div>
      <div class="sidebar-card" id="durationCard" style="display:none;">
        <div class="sidebar-body" id="durationEstimates"></div>
      </div>
      <div class="sidebar-card" style="margin-bottom:0;">
        <h3>ℹ️ Hướng dẫn</h3>
        <div class="sidebar-body" style="font-size:12px;color:#666;line-height:1.7;">
          <p>1️⃣ Click chọn <strong>đơn hàng</strong> bên cạnh</p>
          <p>2️⃣ Click vào ô <strong>trống (+)</strong> trên timeline để chọn ngày</p>
          <p>3️⃣ Nhấn <strong>"Gán đơn"</strong> để xác nhận</p>
          <hr style="margin:10px 0;border:none;border-top:1px solid #e8edf5;">
            <p>🟢 Xanh = đang SX<br>🔵 Xanh dương = chờ SX<br>🔴 Đỏ = trễ hạn<br>⚪ Xám = hoàn thành</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="footer">© 2026 Fabric Production Management System</div>
<div id="toast" class="toast"></div>

<script>
  let allOrders = [];
  let allLines = [];
  let selectedOrder = null;
  let pendingAssign = null;
  let ganttData = null;
  let currentViewStart = null;
  let currentViewEnd = null;

  document.addEventListener('DOMContentLoaded', () => { loadData(); });

  async function loadData() {
    try {
      const serverOrders = <%- JSON.stringify(orders || []) %>;
      const serverLines = <%- JSON.stringify(lines || []) %>;
      if (serverOrders && serverOrders.length) { allOrders = serverOrders; allLines = serverLines; }
      else {
        const [oRes, lRes] = await Promise.all([fetch('/api/orders'), fetch('/api/production-lines')]);
        allOrders = await oRes.json(); allLines = await lRes.json();
      }
      renderOrders(); updateStats();
      // Default view: 30 days from today
      const today = new Date();
      const end = new Date(today); end.setDate(end.getDate() + 30);
      setDateRange(today, end);
      loadGantt();
    } catch(e) { console.error('Load error:', e); }
  }

  function setDateRange(start, end) {
    currentViewStart = start;
    currentViewEnd = end;
    document.getElementById('startDate').value = start.toISOString().split('T')[0];
    document.getElementById('endDate').value = end.toISOString().split('T')[0];
    const diff = Math.round((end - start) / (86400000)) + 1;
    const fmt = (d) => d.toLocaleDateString('vi-VN', { day:'numeric', month:'short', year:'numeric' });
    document.getElementById('rangeLabel').textContent = `${fmt(start)} → ${fmt(end)} (${diff} ngày)`;
  }

  function applyDateRange() {
    const start = new Date(document.getElementById('startDate').value + 'T00:00:00');
    const end = new Date(document.getElementById('endDate').value + 'T00:00:00');
    if (isNaN(start) || isNaN(end)) { showToast('⚠️ Vui lòng chọn ngày hợp lệ', 'error'); return; }
    if (start > end) { showToast('⚠️ Ngày bắt đầu phải trước ngày kết thúc', 'error'); return; }
    setDateRange(start, end);
    loadGantt();
    // Update active quick range button
    document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));
  }

  function quickRange(days, btn) {
    const today = new Date();
    today.setHours(0,0,0,0);
    const end = new Date(today); end.setDate(end.getDate() + days);
    setDateRange(today, end);
    loadGantt();
    document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
  }

  function shiftDays(days) {
    if (!currentViewStart) return;
    const newStart = new Date(currentViewStart);
    newStart.setDate(newStart.getDate() + days);
    const newEnd = new Date(currentViewEnd);
    newEnd.setDate(newEnd.getDate() + days);
    setDateRange(newStart, newEnd);
    loadGantt();
    document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));
  }

  function goToToday() {
    const today = new Date(); today.setHours(0,0,0,0);
    const end = new Date(today); end.setDate(end.getDate() + 30);
    setDateRange(today, end);
    loadGantt();
    document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));
    // Highlight 30 ngày
    const btns = document.querySelectorAll('.btn-nav');
    btns.forEach((b,i) => { if (b.textContent === '30 ngày') b.classList.add('active'); });
  }

  async function loadGantt() {
    try {
      const start = currentViewStart.toISOString().split('T')[0];
      const end = currentViewEnd.toISOString().split('T')[0];
      const res = await fetch(`/api/schedule/gantt-all?start_date=${start}&end_date=${end}`);
      ganttData = await res.json();
      renderGantt();
    } catch(e) { console.error('Gantt error:', e); }
  }

  function updateStats() {
    const pending = allOrders.filter(o => o.status === 'pending' || o.status === 'approved').length;
    const running = allLines.filter(l => l.status === 'RUNNING').length;
    const scheduled = ganttData?.stats?.total_scheduled || 0;
    document.getElementById('statLines').textContent = allLines.length;
    document.getElementById('statRunning').textContent = running;
    document.getElementById('statPending').textContent = pending;
    document.getElementById('statUtil').textContent = allLines.length ? Math.round(scheduled / Math.max(allLines.length * 3, 1) * 100) : 0;
    if (ganttData?.stats?.overdue > 0) {
      document.getElementById('overdueStat').style.display = 'block';
      document.getElementById('statOverdue').textContent = ganttData.stats.overdue;
    }
  }

  function renderOrders() {
    const container = document.getElementById('orderList');
    const pending = allOrders.filter(o => o.status === 'pending' || o.status === 'approved');
    if (!pending.length) { container.innerHTML = '<div class="empty-state"><h3>✅ Tất cả đã xử lý</h3></div>'; return; }
    container.innerHTML = pending.map((o, idx) => `
      <div class="order-item ${selectedOrder?.ma_dh === o.ma_dh ? 'selected' : ''}" onclick="selectOrder(${idx})">
        <div class="oi-header"><span class="oi-code">${o.ma_dh}</span><span class="badge badge-${o.status}">${o.status}</span></div>
        <div class="oi-customer">${o.ten_kh}</div>
        <div class="oi-details"><span>${o.product ? o.product.ten_sp : o.ma_sp}</span><span>${Number(o.so_luong).toLocaleString()} cái · ${o.ngay_giao || '—'}</span></div>
      </div>
    `).join('');
  }

  function selectOrder(idx) {
    const pending = allOrders.filter(o => o.status === 'pending' || o.status === 'approved');
    selectedOrder = pending[idx];
    document.querySelectorAll('.order-item').forEach(el => el.classList.remove('selected'));
    document.querySelectorAll('.order-item')[idx]?.classList.add('selected');
    pendingAssign = null;
    document.getElementById('assignBar').classList.remove('visible');
    // Show slot suggestions
    showSlotSuggestions();
    showToast(`📌 Đã chọn: ${selectedOrder.ma_dh}`, 'success');
  }

  async function showSlotSuggestions() {
    if (!selectedOrder) {
      document.getElementById('durationCard').style.display = 'none';
      return;
    }
    try {
      const res = await fetch('/api/schedule/suggest-slot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ma_dh: selectedOrder.ma_dh,
          so_luong: selectedOrder.so_luong,
          ngay_giao: selectedOrder.ngay_giao
        })
      });
      const suggestions = await res.json();
      if (!suggestions || suggestions.length === 0) {
        document.getElementById('durationCard').style.display = 'none';
        return;
      }
      // Render duration panel
      const container = document.getElementById('durationEstimates');
      const card = document.getElementById('durationCard');
      const order = selectedOrder;
      const so_luong = Number(order.so_luong);
      const ngay_giao = order.ngay_giao;
      const today = new Date(); today.setHours(0,0,0,0);
      const giaoDate = ngay_giao ? new Date(ngay_giao + 'T00:00:00') : null;
      const daysToDelivery = giaoDate ? Math.ceil((giaoDate - today) / 86400000) : null;

      let html = `<div style="font-size:13px;font-weight:700;color:#1F3864;margin-bottom:6px;">⏱ Phân tích đơn hàng</div>`;
      html += `<div style="font-size:12px;color:#666;margin-bottom:10px;">${order.ma_dh} · ${order.ten_kh} · ${so_luong.toLocaleString()} cái</div>`;

      suggestions.forEach(s => {
        const prodDays = s.production_days;
        const canMeet = daysToDelivery !== null ? prodDays <= daysToDelivery : true;
        const color = canMeet ? '#28a745' : '#dc3545';
        const icon = canMeet ? '✅' : '⚠️';
        const overdueText = s.is_overdue ? ' · <span style="color:#dc3545;font-weight:700;">TRỄ HẠN</span>' : '';
        html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 10px;border:1px solid #e8edf5;border-radius:6px;margin-bottom:4px;font-size:12px;">
          <div><span style="font-weight:600;color:#1F3864;">${s.ten_pipe}</span><br><span style="font-size:11px;color:#888;">${s.status} · ${s.queue_length} đơn chờ</span></div>
          <div style="text-align:right;">
            <span style="color:#555;">${s.daily_capacity} sp/ng → <strong style="color:${color};">${prodDays} ngày</strong> ${icon}</span><br>
            <span style="font-size:11px;color:#888;">${s.slot_start} → ${s.slot_end}${overdueText}</span>
          </div>
        </div>`;
      });
      container.innerHTML = html;
      card.style.display = 'block';
      if (ganttData) renderGantt();
      // Also show first 3 in a brief toast
      const top3 = suggestions.slice(0, 3).map(s =>
        `${s.ten_pipe}: ${s.slot_start}→${s.slot_end} (${s.production_days} ngày${s.is_overdue ? ' ⛔' : ''})`
      ).join('<br>');
      showToast(`💡 Đề xuất cho ${selectedOrder.ma_dh}:<br>${top3}`, 'success');
    } catch(e) { console.error('Suggest error:', e); }
  }

  function renderGantt() {
    if (!ganttData) return;
    const { dates, lines } = ganttData;
    renderGanttDates(dates);
    renderGanttLines(dates, lines);
  }

  function renderGanttDates(dates) {
    const container = document.getElementById('ganttDates');
    const today = new Date().toISOString().split('T')[0];
    container.innerHTML = dates.map(d => {
      const date = new Date(d + 'T00:00:00');
      const dayNames = ['CN','Th2','Th3','Th4','Th5','Th6','Th7'];
      const isWeekend = date.getDay() === 0 || date.getDay() === 6;
      const isToday = d === today;
      return `<div class="col ${isWeekend?'weekend':''} ${isToday?'today':''}"><span>${dayNames[date.getDay()]}</span><span class="num">${date.getDate()}/${date.getMonth()+1}</span></div>`;
    }).join('');
  }

  function renderGanttLines(dates, lines) {
    const container = document.getElementById('ganttBody');
    if (!lines || !lines.length) { container.innerHTML = '<div style="padding:40px;text-align:center;color:#999;">Chưa có dữ liệu</div>'; return; }

    container.innerHTML = lines.map(line => {
      const today = new Date().toISOString().split('T')[0];
      const jobMap = {};
      line.jobs.forEach(j => { jobMap[j.date] = j; });

      let cellsHtml = '';
      for (let idx = 0; idx < dates.length; idx++) {
        const d = dates[idx];
        const date = new Date(d + 'T00:00:00');
        const isWeekend = date.getDay() === 0 || date.getDay() === 6;
        const isToday = d === today;
        const job = jobMap[d];

        if (job) {
          // Check if this is the start of a contiguous job block
          const prevJob = jobMap[dates[idx-1]];
          if (prevJob?.ma_dh === job.ma_dh) {
            cellsHtml += `<div class="col ${isWeekend?'weekend':''} ${isToday?'today':''}"></div>`;
          } else {
            // Calculate span of this job
            let span = 1;
            for (let j = idx + 1; j < dates.length; j++) {
              if (jobMap[dates[j]]?.ma_dh === job.ma_dh) span++;
              else break;
            }
            const jobWidth = Math.max(span * 38 - 4, 10);
            
            // Map job status to CSS class
            let jobClass = 'queued';
            if (job.status === 'RUNNING' || job.status === 'running') jobClass = 'running';
            else if (job.status === 'OVERDUE' || job.status === 'overdue') jobClass = 'overdue';
            else if (job.status === 'COMPLETED' || job.status === 'completed') jobClass = 'completed';
            
            const tooltip = `${job.ma_dh} - ${job.product||''} - ${job.customer||''}${job.is_overdue ? ' ⚠️ TRỄ HẠN!' : ''}`;
            
            cellsHtml += `<div class="col ${isWeekend?'weekend':''} ${isToday?'today':''}" style="position:relative;">
              <div class="gantt-job ${jobClass}" style="left:2px;width:${jobWidth}px;" title="${tooltip}" onclick="event.stopPropagation();showJobInfo('${job.ma_dh}')">
                <span class="label">${job.ma_dh}${job.is_overdue ? ' ⛔' : ''}</span>
              </div>
            </div>`;
          }
        } else {
          // Free cell: show clickable + slot if an order is selected
          const hasOrder = selectedOrder !== null;
          cellsHtml += `<div class="col ${isWeekend?'weekend':''} ${isToday?'today':''}" ${hasOrder ? `style="cursor:pointer;" onclick="selectSlot('${line.ma_pipe}','${d}')"` : ''}>
            ${hasOrder ? `<div class="gantt-job free-slot" style="left:2px;width:34px;height:44px;top:6px;"><span class="label">+</span></div>` : ''}
          </div>`;
        }
      }

      const statusDot = line.status === 'RUNNING' ? 'running' : line.status === 'STOPPED' ? 'stopped' : 'idle';
      return `<div class="gantt-row" id="gantt-row-${line.ma_pipe}">
        <div class="gantt-row-label">
          <span class="dot ${statusDot}"></span>
          <div><div class="name">${line.ten_pipe}</div><div class="code">${line.ma_pipe} · ${line.status}</div></div>
        </div>
        <div class="gantt-timeline">${cellsHtml}</div>
      </div>`;
    }).join('');
  }

  function selectSlot(ma_pipe, start_date) {
    if (!selectedOrder) { showToast('⚠️ Chọn đơn hàng trước', 'error'); return; }
    pendingAssign = { ma_dh: selectedOrder.ma_dh, ma_pipe, start_date };
    document.getElementById('assignOrderLabel').textContent = selectedOrder.ma_dh;
    document.getElementById('assignLineLabel').textContent = ma_pipe;
    document.getElementById('assignDateLabel').textContent = `Bắt đầu: ${start_date}`;
    document.getElementById('assignBar').classList.add('visible');
    document.querySelectorAll('.gantt-row').forEach(r => r.style.background = '');
    const row = document.getElementById('gantt-row-' + ma_pipe);
    if (row) row.style.background = '#e8f4ff';
  }

  function cancelAssign() {
    pendingAssign = null;
    document.getElementById('assignBar').classList.remove('visible');
    document.querySelectorAll('.gantt-row').forEach(r => r.style.background = '');
  }

  async function confirmAssign() {
    if (!pendingAssign) return;
    const btn = document.getElementById('confirmAssignBtn');
    btn.disabled = true; btn.textContent = '⏳ Đang gán...';
    try {
      const res = await fetch('/api/schedule/assign', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(pendingAssign) });
      const data = await res.json();
      if (res.ok) { showToast('✅ '+data.msg,'success'); cancelAssign(); setTimeout(()=>location.reload(),1500); }
      else { showToast('❌ '+data.msg,'error'); btn.disabled=false; btn.textContent='✅ Gán đơn'; }
    } catch(e) { showToast('❌ Lỗi: '+e.message,'error'); btn.disabled=false; btn.textContent='✅ Gán đơn'; }
  }

  function showJobInfo(ma_dh) {
    const order = allOrders.find(o => o.ma_dh === ma_dh);
    if (order) showToast(`📋 ${order.ma_dh} - ${order.ten_kh} - ${order.product?.ten_sp||order.ma_sp} (${Number(order.so_luong).toLocaleString()} cái)`,'success');
  }

  function showToast(msg, type) {
    const t = document.getElementById('toast');
    t.className = 'toast toast-' + type;
    t.innerHTML = msg;
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 3000);
  }
</script>
</body>
</html>
